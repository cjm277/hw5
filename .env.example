# Copy this file to .env in the project root and fill in your own key. Never commit .env.
#   cp .env.example .env
#
# Every agent uses gpt-6-luna through Portkey. The model name is set in backend/config.py;
# the backend refuses to start if OPENAI_MODEL below names any other model.
PORTKEY_API_KEY=
# Optional. If you set it, it must be gpt-6-luna.
OPENAI_MODEL=gpt-6-luna
